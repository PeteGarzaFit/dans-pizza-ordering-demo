# Copy to .env to enable Retell endpoints. Never put API keys in public/ or browser code.
RETELL_API_KEY=
RETELL_AGENT_ID=
# Optional shared secret for protecting the custom order tool endpoint
ORDER_TOOL_SECRET=
## Required on public deployments; use at least 12 characters.
DASHBOARD_PASSWORD=
## Required on public deployments; generate a random value at least 32 characters long.
SESSION_SECRET=
PORT=3000
